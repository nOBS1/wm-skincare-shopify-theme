<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        {%- if settings.logo != blank -%}
          {%- assign logo_w = settings.logo_width | default: 160 -%}
          {%- assign logo_h = logo_w | times: settings.logo.height | divided_by: settings.logo.width -%}
          <a href="{{ routes.root_url }}"><img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name }}" width="{{ logo_w }}" height="{{ logo_h }}" loading="lazy" style="width:{{ logo_w }}px;height:auto"></a>
        {%- else -%}
          <span class="footer-logo-text">{{ shop.name }}</span>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="footer-description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      <div class="footer-grid">
        {%- for block in section.blocks -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            <nav>
              {%- assign menu = block.settings.menu -%}
              {%- for link in menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            </nav>
          </div>
        {%- endfor -%}
        <div class="footer-col">
          <h4>Customer care</h4>
          <nav aria-label="Customer care">
            <a href="{{ routes.search_url }}">Search</a>
            <a href="{{ routes.cart_url }}">Your bag</a>
            {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">Your account</a>{%- endif -%}
          </nav>
        </div>
        {%- if shop.policies.size > 0 -%}
          <div class="footer-col">
            <h4>Information</h4>
            <nav aria-label="Store policies">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endif -%}
              {%- endfor -%}
            </nav>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="lx-newsletter">
        <h3>{{ section.settings.newsletter_heading | default: 'Join the Poetry List' }}</h3>
        <p>{{ section.settings.newsletter_sub | default: 'Early access · Private rituals · No noise' }}</p>
        {%- form 'customer', class: 'lx-news-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="lx-form-success">Welcome — you are on the list.</p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="lx-form-success">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
            <input type="email" name="contact[email]" placeholder="Email address"
                   aria-label="Email address" autocomplete="email" required
                   {% if customer %}value="{{ customer.email }}"{% endif %}>
            <button type="submit">Subscribe</button>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_wordmark -%}
      <div class="lx-foot-mark" aria-hidden="true">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 1600 }}" alt="" width="{{ settings.logo.width }}" height="{{ settings.logo.height }}" loading="lazy">
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="footer-bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
      <div class="footer-social">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_facebook != blank -%}
          <a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_twitter != blank -%}
          <a href="{{ settings.social_twitter }}" aria-label="Twitter" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4l11.7 16h4.3L8.3 4H4zm4 16l12-16"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Brand description", "default": "Luxury exosome skincare — where cutting-edge science meets timeless beauty rituals." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join the Poetry List" },
    { "type": "text", "id": "newsletter_sub", "label": "Newsletter subtitle", "default": "Early access · Private rituals · No noise" },
    { "type": "header", "content": "Wordmark" },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show oversized wordmark", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [{
    "name": "Footer",
    "blocks": [
      { "type": "menu", "settings": { "title": "Shop" }},
      { "type": "menu", "settings": { "title": "About" }},
      { "type": "menu", "settings": { "title": "Help" }}
    ]
  }]
}
{% endschema %}
