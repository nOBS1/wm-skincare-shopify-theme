{%- if section.settings.text != blank -%}
<div class="announcement-bar" role="region" aria-label="Announcement">
  <div class="lx-marquee">
    <div class="lx-marquee-track">
      {%- for i in (1..2) -%}
        <span>
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
          {%- else -%}
            {{ section.settings.text }}
          {%- endif -%}
          {%- if section.settings.text_2 != blank -%}
            &nbsp;&nbsp;·&nbsp;&nbsp;
            {%- if section.settings.link_2 != blank -%}
              <a href="{{ section.settings.link_2 }}">{{ section.settings.text_2 }}</a>
            {%- else -%}
              {{ section.settings.text_2 }}
            {%- endif -%}
          {%- endif -%}
          &nbsp;&nbsp;·&nbsp;&nbsp;
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Complimentary worldwide shipping on all orders over $150"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "Second message",
      "default": "Exosome science meets poetic skincare"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Second link"
    }
  ]
}
{% endschema %}
