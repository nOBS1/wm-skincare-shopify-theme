<section class="section featured-products">
  <div class="container">
    <div class="section-header lx-reveal">
      {%- if section.settings.label != blank -%}
        <span class="section-label">{{ section.settings.label }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2>{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p>{{ section.settings.description }}</p>
      {%- endif -%}
    </div>
    <div class="product-grid">
      {%- assign collection = collections[section.settings.collection] | default: collections.all -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        <div class="product-card lx-reveal" data-lx-hover>
          <div class="product-card-img">
            <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}"
                     srcset="{{ product.featured_image | image_url: width: 300 }} 300w,
                             {{ product.featured_image | image_url: width: 450 }} 450w,
                             {{ product.featured_image | image_url: width: 600 }} 600w,
                             {{ product.featured_image | image_url: width: 900 }} 900w"
                     sizes="(min-width: 1100px) 300px, (min-width: 640px) 33vw, 50vw"
                     alt="{{ product.featured_image.alt | default: product.title | escape }}"
                     loading="lazy"
                     width="600"
                     height="600"
                     decoding="async">
                {%- if product.images[1] != blank and product.images[1].aspect_ratio >= 0.4 -%}
                  <img class="lx-img-b"
                       src="{{ product.images[1] | image_url: width: 600 }}"
                       srcset="{{ product.images[1] | image_url: width: 300 }} 300w,
                               {{ product.images[1] | image_url: width: 600 }} 600w"
                       sizes="(min-width: 1100px) 300px, (min-width: 640px) 33vw, 50vw"
                       alt=""
                       loading="lazy"
                       width="600"
                       height="600"
                       decoding="async">
                {%- endif -%}
              {%- else -%}
                <div class="product-card-placeholder"></div>
              {%- endif -%}
            </a>

            {%- if product.compare_at_price > product.price -%}
              <span class="lx-card-tag lx-tag-sale">Sale</span>
            {%- elsif section.settings.new_label and product.tags contains 'new' -%}
              <span class="lx-card-tag">New</span>
            {%- endif -%}

            <button class="lx-wish" type="button" data-wish="{{ product.id }}" data-title="{{ product.title | escape }}" aria-label="Add {{ product.title | escape }} to wishlist">♡</button>
            <button class="lx-quick-view-btn" type="button" data-lx-qv="{{ product.id }}">Quick View</button>
            <button class="lx-quick-add" type="button" data-lx-add="{{ product.selected_or_first_available_variant.id }}" {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}+ Quick Add{%- else -%}Sold Out{%- endif -%}
            </button>
          </div>
          <div class="product-card-info">
            <h3 class="product-card-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="product-card-price">
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
              {%- endif -%}
              {{ product.price | money }}
            </p>
          </div>

          {%- comment -%} Quick view data source {%- endcomment -%}
          <script type="application/json" data-lx-product="{{ product.id }}">
          {
            "id": {{ product.id }},
            "title": {{ product.title | json }},
            "url": {{ product.url | json }},
            "available": {{ product.available }},
            "price": {{ product.price | money | json }},
            "compare": {%- if product.compare_at_price > product.price -%}{{ product.compare_at_price | money | json }}{%- else -%}null{%- endif -%},
            "vendor": {{ product.vendor | json }},
            "type": {{ product.type | json }},
            "default_variant": {{ product.selected_or_first_available_variant.id | default: 0 }},
            "only_default": {{ product.has_only_default_variant }},
            "images": [{%- assign photo_emitted = false -%}{%- for image in product.images -%}{%- if image.aspect_ratio >= 0.4 -%}{% if photo_emitted %},{% endif %}{{ image | image_url: width: 800 | json }}{%- assign photo_emitted = true -%}{%- endif -%}{%- endfor -%}],
            "variants": [{%- for v in product.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"available":{{ v.available }},"price":{{ v.price | money | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
          }
          </script>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button_text != blank -%}
      <div class="section-cta">
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn-primary">{{ section.settings.button_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "label", "label": "Top label", "default": "Curated for You" },
    { "type": "text", "id": "title", "label": "Title", "default": "Bestsellers" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Our most-loved formulas — where advanced exosome science meets pure indulgence." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "checkbox", "id": "new_label", "label": "Show 'New' badge for products tagged 'new'", "default": true },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "View All Products" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
