{%- liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign reading_time = word_count | divided_by: 200 | at_least: 1

  comment
    Show "Updated" only when the article was meaningfully edited after publishing
  endcomment
  assign pub_ts = article.published_at | date: '%s' | plus: 0
  assign upd_ts = article.updated_at | date: '%s' | plus: 0
  assign updated_diff = upd_ts | minus: pub_ts

  assign article_abs_url = shop.url | append: article.url

  assign article_img_abs = ''
  if article.image
    assign article_img_abs = article.image | image_url: width: 1200
    unless article_img_abs contains 'https:'
      assign article_img_abs = article_img_abs | prepend: 'https:'
    endunless
  endif

  assign faqs = article.metafields.custom.faqs.value
  assign sources = article.metafields.custom.sources.value
-%}

<div class="container">
  {%- render 'breadcrumb' -%}

  <article class="article-content">
    <header class="article-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- else -%}
        <span class="section-eyebrow">{{ blog.title }}</span>
      {%- endif -%}
      <h1>{{ article.title }}</h1>
      <p class="article-meta">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
        {%- if updated_diff > 86400 -%}
          <span>Updated <time datetime="{{ article.updated_at | date: '%Y-%m-%d' }}">{{ article.updated_at | date: '%B %d, %Y' }}</time></span>
        {%- endif -%}
        {%- if article.author != blank -%}
          <span>By {{ article.author }}</span>
        {%- endif -%}
        <span>{{ reading_time }} min read</span>
      </p>
    </header>

    {%- if article.image -%}
      <figure class="article-hero">
        <img
          src="{{ article.image | image_url: width: 1080 }}"
          srcset="{{ article.image | image_url: width: 720 }} 720w,
                  {{ article.image | image_url: width: 1080 }} 1080w,
                  {{ article.image | image_url: width: 1440 }} 1440w,
                  {{ article.image | image_url: width: 2160 }} 2160w"
          sizes="(min-width: 800px) 720px, calc(100vw - 40px)"
          alt="{{ article.image.alt | default: article.title | escape }}"
          width="{{ article.image.width }}"
          height="{{ article.image.height }}"
          loading="eager"
          fetchpriority="high">
      </figure>
    {%- endif -%}

    {%- comment -%} GEO: answer-first summary AI engines can lift verbatim {%- endcomment -%}
    {%- if article.metafields.custom.key_takeaways != blank -%}
      <aside class="article-takeaways">
        <h2>Key takeaways</h2>
        <ul>
          {%- assign takeaway_lines = article.metafields.custom.key_takeaways.value | newline_to_br | split: '<br />' -%}
          {%- for line in takeaway_lines -%}
            {%- assign line_clean = line | strip -%}
            {%- if line_clean != blank -%}<li>{{ line_clean }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </aside>
    {%- endif -%}

    {%- if section.settings.show_toc -%}
      <nav class="article-toc" data-article-toc hidden aria-label="Table of contents">
        <p class="article-toc-title">On this page</p>
        <ol data-toc-list></ol>
      </nav>
    {%- endif -%}

    <div class="article-body rte">
      {{ article.content }}
    </div>

    {%- comment -%} GEO: FAQPage block, metafield-driven, hidden when empty (same custom.faqs contract as product pages) {%- endcomment -%}
    {%- if article.metafields.custom.faqs != blank -%}
      <section class="article-faq">
        <div class="section-head">
          <span class="section-eyebrow">Q &amp; A</span>
          <span class="section-line"></span>
        </div>
        <h2>Frequently asked questions</h2>
        {%- for faq in faqs -%}
          <details class="faq-item">
            <summary>{{ faq.question }}</summary>
            <div class="faq-answer"><p>{{ faq.answer }}</p></div>
          </details>
        {%- endfor -%}
      </section>
    {%- endif -%}

    {%- comment -%} GEO: verifiable citations build trust with AI engines {%- endcomment -%}
    {%- if article.metafields.custom.sources != blank -%}
      <section class="article-sources">
        <div class="section-head">
          <span class="section-eyebrow">References</span>
          <span class="section-line"></span>
        </div>
        <ol>
          {%- for source in sources -%}
            <li><a href="{{ source.url }}" rel="noopener" target="_blank">{{ source.label }}</a></li>
          {%- endfor -%}
        </ol>
      </section>
    {%- endif -%}

    {%- if article.tags.size > 0 -%}
      <div class="article-tags">
        {%- for tag in article.tags -%}
          <a class="blog-tag" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_author_bio and article.user.bio != blank -%}
      <aside class="article-author">
        <p class="section-eyebrow">About the author</p>
        <p class="article-author-name">{{ article.author }}</p>
        <p class="article-author-bio">{{ article.user.bio }}</p>
      </aside>
    {%- endif -%}

    {%- if section.settings.show_prev_next -%}
      {%- if blog.previous_article or blog.next_article -%}
        <nav class="article-nav-block" aria-label="More articles">
          <div class="article-nav-grid">
            {%- if blog.previous_article -%}
              <a class="article-nav-link prev" href="{{ blog.previous_article.url }}">
                <span class="dir">Previous</span>
                {{ blog.previous_article.title }}
              </a>
            {%- else -%}
              <span></span>
            {%- endif -%}
            {%- if blog.next_article -%}
              <a class="article-nav-link next" href="{{ blog.next_article.url }}">
                <span class="dir">Next</span>
                {{ blog.next_article.title }}
              </a>
            {%- endif -%}
          </div>
        </nav>
      {%- endif -%}
    {%- endif -%}

    {%- if blog.comments_enabled? -%}
      <section class="article-comments" id="comments">
        <div class="section-head">
          <span class="section-eyebrow">Comments ({{ article.comments_count }})</span>
          <span class="section-line"></span>
        </div>
        {%- paginate article.comments by 20 -%}
          {%- for comment in article.comments -%}
            <div class="comment">
              <p class="comment-meta">
                <strong>{{ comment.author }}</strong>
                <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: '%B %d, %Y' }}</time>
              </p>
              <div class="rte">{{ comment.content }}</div>
            </div>
          {%- endfor -%}
          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Comments pagination">{{ paginate | default_pagination }}</nav>
          {%- endif -%}
        {%- endpaginate -%}

        {%- form 'new_comment', article -%}
          {%- if form.posted_successfully? -%}
            <p class="form-status" role="status">
              {%- if blog.moderated? -%}Thank you — your comment will appear once it has been approved.{%- else -%}Thank you — your comment has been posted.{%- endif -%}
            </p>
          {%- elsif form.errors -%}
            <p class="form-status form-status--error" role="alert">Your comment could not be posted — please check the fields and try again.</p>
          {%- endif -%}
          <div class="form-group">
            <label for="CommentAuthor">Name</label>
            <input type="text" id="CommentAuthor" name="comment[author]" autocomplete="name" required>
          </div>
          <div class="form-group">
            <label for="CommentEmail">Email</label>
            <input type="email" id="CommentEmail" name="comment[email]" autocomplete="email" required>
          </div>
          <div class="form-group">
            <label for="CommentBody">Comment</label>
            <textarea id="CommentBody" name="comment[body]" rows="5" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Post comment</button>
        {%- endform -%}
      </section>
    {%- endif -%}
  </article>

  {%- if section.settings.show_related and blog.articles_count > 1 -%}
    <aside class="article-related">
      <div class="section-head">
        <span class="section-eyebrow">Keep reading</span>
        <span class="section-line"></span>
      </div>
      <div class="blog-grid">
        {%- assign related_shown = 0 -%}
        {%- for related in blog.articles limit: 4 -%}
          {%- if related.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- if related_shown >= 3 -%}{%- break -%}{%- endif -%}
          {%- assign related_shown = related_shown | plus: 1 -%}
          {%- render 'article-card', card_article: related, heading_tag: 'h3' -%}
        {%- endfor -%}
      </div>
    </aside>
  {%- endif -%}
</div>

{%- comment -%} GEO: BlogPosting entity — absolute URLs only (image_url returns protocol-relative) {%- endcomment -%}
{%- liquid
  assign publisher_logo = ''
  if settings.logo != blank
    assign publisher_logo = settings.logo | image_url: width: 512
  elsif settings.favicon != blank
    assign publisher_logo = settings.favicon | image_url: width: 512
  endif
  unless publisher_logo == '' or publisher_logo contains 'https:'
    assign publisher_logo = publisher_logo | prepend: 'https:'
  endunless
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": {{ article_abs_url | append: '#article' | json }},
  "mainEntityOfPage": { "@type": "WebPage", "@id": {{ article_abs_url | json }} },
  "url": {{ article_abs_url | json }},
  "headline": {{ article.title | json }},
  "description": {{ article.excerpt_or_content | strip_html | truncate: 300 | json }},
  {%- if article_img_abs != '' -%}
  "image": [{{ article_img_abs | json }}],
  {%- endif -%}
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
  "author": { "@type": "Person", "name": {{ article.author | json }} },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}{%- if publisher_logo != '' -%},
    "logo": { "@type": "ImageObject", "url": {{ publisher_logo | json }} }{%- endif -%}
  },
  "isPartOf": { "@type": "Blog", "@id": "{{ shop.url }}{{ blog.url }}#blog", "name": {{ blog.title | json }} },
  "articleSection": {{ blog.title | json }},
  {%- if article.tags.size > 0 -%}
  "keywords": {{ article.tags | join: ', ' | json }},
  {%- endif -%}
  "wordCount": {{ word_count }},
  "commentCount": {{ article.comments_count }},
  "inLanguage": {{ request.locale.iso_code | json }},
  "isAccessibleForFree": true,
  "speakable": { "@type": "SpeakableSpecification", "cssSelector": [".article-header h1", ".article-takeaways"] }
}
</script>

{%- if article.metafields.custom.faqs != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for faq in faqs -%}
    {
      "@type": "Question",
      "name": {{ faq.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ faq.answer | json }} }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Article page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "info": "Defaults to the blog title when empty" },
    { "type": "checkbox", "id": "show_toc", "label": "Show table of contents", "default": true },
    { "type": "checkbox", "id": "show_author_bio", "label": "Show author bio (from staff account bio)", "default": true },
    { "type": "checkbox", "id": "show_prev_next", "label": "Show previous / next article links", "default": true },
    { "type": "checkbox", "id": "show_related", "label": "Show related articles", "default": true }
  ]
}
{% endschema %}
