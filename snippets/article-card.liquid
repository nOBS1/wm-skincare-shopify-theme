{%- comment -%}
  Article card — shared by blog grid and "related articles".
  Params:
    card_article  (required) article object
    img_loading   'lazy' (default) | 'eager'
    img_priority  true → fetchpriority="high" (first card above the fold)
    heading_tag   'h2' (default) | 'h3' (use h3 inside article pages)
{%- endcomment -%}
{%- assign card_heading = heading_tag | default: 'h2' -%}
<article class="blog-card">
  {%- if card_article.image -%}
    <a href="{{ card_article.url }}" class="blog-card-img" tabindex="-1" aria-hidden="true">
      <img
        src="{{ card_article.image | image_url: width: 600 }}"
        srcset="{{ card_article.image | image_url: width: 400 }} 400w,
                {{ card_article.image | image_url: width: 600 }} 600w,
                {{ card_article.image | image_url: width: 800 }} 800w,
                {{ card_article.image | image_url: width: 1200 }} 1200w"
        sizes="(min-width: 1100px) 400px, (min-width: 700px) 50vw, calc(100vw - 40px)"
        alt="{{ card_article.image.alt | default: card_article.title | escape }}"
        width="{{ card_article.image.width }}"
        height="{{ card_article.image.height }}"
        loading="{{ img_loading | default: 'lazy' }}"
        {% if img_priority %}fetchpriority="high"{% endif %}
        decoding="async">
    </a>
  {%- endif -%}
  <div class="blog-card-body">
    <p class="blog-card-meta">
      <time datetime="{{ card_article.published_at | date: '%Y-%m-%d' }}">{{ card_article.published_at | date: '%B %d, %Y' }}</time>
      {%- if card_article.author != blank %} <span aria-hidden="true">·</span> {{ card_article.author }}{% endif -%}
    </p>
    <{{ card_heading }} class="blog-card-title"><a href="{{ card_article.url }}">{{ card_article.title }}</a></{{ card_heading }}>
    <p class="blog-card-excerpt">{{ card_article.excerpt_or_content | strip_html | truncate: 140 }}</p>
    <a class="blog-card-more" href="{{ card_article.url }}">Read article</a>
  </div>
</article>
