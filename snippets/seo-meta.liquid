{%- comment -%}Open Graph & Twitter Card meta tags for SEO/GEO{%- endcomment -%}
{%- liquid
  assign og_image = blank
  if template contains 'product' and product.featured_image
    assign og_image = product.featured_image
  elsif template contains 'article' and article.image
    assign og_image = article.image
  elsif settings.og_image
    assign og_image = settings.og_image
  endif

  comment
    image_url returns protocol-relative URLs (//cdn.shopify.com/...) — OG/Twitter require absolute
  endcomment
  if og_image != blank
    assign og_image_w = og_image.width | at_most: 1200
    assign og_image_h = og_image_w | divided_by: og_image.aspect_ratio | round
    assign og_image_url = og_image | image_url: width: og_image_w
    unless og_image_url contains 'https:'
      assign og_image_url = og_image_url | prepend: 'https:'
    endunless
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:type" content="{% if template contains 'product' %}product{% elsif template contains 'article' %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:description" content="{{ page_description | escape | default: shop.description | escape }}">
{%- if og_image != blank -%}
<meta property="og:image" content="{{ og_image_url }}">
<meta property="og:image:width" content="{{ og_image_w }}">
<meta property="og:image:height" content="{{ og_image_h }}">
{%- if og_image.alt != blank -%}
<meta property="og:image:alt" content="{{ og_image.alt | escape }}">
{%- endif -%}
{%- endif -%}
{%- if template contains 'product' -%}
<meta property="product:price:amount" content="{{ product.price | money_without_currency }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
{%- if template contains 'article' -%}
<meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
<meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
{%- if article.author != blank -%}
<meta property="article:author" content="{{ article.author | escape }}">
{%- endif -%}
{%- for tag in article.tags -%}
<meta property="article:tag" content="{{ tag | escape }}">
{%- endfor -%}
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
<meta name="twitter:description" content="{{ page_description | escape | default: shop.description | escape }}">
{%- if og_image != blank -%}
<meta name="twitter:image" content="{{ og_image_url }}">
{%- endif -%}
