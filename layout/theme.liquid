<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  {%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">
  {%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <title>
    {{ page_title }}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}
  </title>
  {%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- comment -%} Open Graph / Twitter Card (snippet also emits product price meta) {%- endcomment -%}
  {%- render 'seo-meta' -%}

  {%- comment -%} Organization Schema for GEO {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    {%- if settings.logo != blank -%}
    "logo": {{ settings.logo | image_url: width: 512 | json }},
    {%- elsif settings.favicon != blank -%}
    "logo": {{ settings.favicon | image_url: width: 512 | json }},
    {%- endif -%}
    {%- assign social_urls = '' -%}
    {%- if settings.social_facebook != blank -%}
      {%- assign social_urls = social_urls | append: settings.social_facebook | append: '|' -%}
    {%- endif -%}
    {%- if settings.social_instagram != blank -%}
      {%- assign social_urls = social_urls | append: settings.social_instagram | append: '|' -%}
    {%- endif -%}
    {%- if settings.social_twitter != blank -%}
      {%- assign social_twitter_url = settings.social_twitter -%}
      {%- unless social_twitter_url contains 'http' -%}
        {%- assign social_twitter_url = social_twitter_url | remove: '@' | prepend: 'https://x.com/' -%}
      {%- endunless -%}
      {%- assign social_urls = social_urls | append: social_twitter_url | append: '|' -%}
    {%- endif -%}
    {%- assign social_list = social_urls | split: '|' -%}
    "sameAs": [{% for social_url in social_list %}{{ social_url | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
  }
  </script>

  {%- comment -%} Breadcrumb schema (product template renders its own richer version inline) {%- endcomment -%}
  {%- unless template contains 'product' -%}
    {%- render 'schema-breadcrumb' -%}
  {%- endunless -%}

  {%- comment -%} Website SearchAction for sitelinks search box {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": "{{ shop.url }}/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-{{ template | replace: '.', '-' }}">
  <a class="skip-link visually-hidden" href="#MainContent">Skip to content</a>
  {%- section 'announcement-bar' -%}
  {%- section 'header' -%}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {%- section 'footer' -%}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
